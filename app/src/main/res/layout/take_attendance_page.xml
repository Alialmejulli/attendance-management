<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2E4F3D"
    android:padding="16dp">

    <!-- Back Arrow -->
    <ImageView
        android:id="@+id/backButton"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="Back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Page Title -->
    <TextView
        android:id="@+id/takeAttendanceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Take Attendance"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/backButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scrollable Container -->
    <ScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/takeAttendanceTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/takeAttendanceContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_white_card"
            android:padding="20dp">

            <!-- Activation Code Section -->
            <TextView
                android:id="@+id/codeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activation Code"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2E4F3D"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/generatedCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="----"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#2E4F3D"
                android:gravity="center"
                android:padding="12dp"
                android:background="#F2F2F2"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnGenerateCode"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Generate Code"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E4F3D"
                android:layout_marginBottom="32dp"/>

            <!-- Timer Section -->
            <TextView
                android:id="@+id/timerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Timer"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2E4F3D"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/timerDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No timer selected"
                android:textSize="18sp"
                android:textColor="#2E4F3D"
                android:gravity="center"
                android:padding="12dp"
                android:background="#F2F2F2"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnChooseTimer"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Choose Timer Duration"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E4F3D"/>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
